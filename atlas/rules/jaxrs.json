{
  "id": "jaxrs",
  "title": "JAX-RS 리소스 (@GET·@POST … 메서드 + @Path. 클래스에 @Path 가 없어도 메서드에 있으면 읽는다)",
  "langs": [
    "java",
    "kotlin"
  ],
  "rules": [
    {
      "id": "resource",
      "type": "annotation",
      "kind": "http",
      "role": "provide",
      "names": {
        "GET": "GET",
        "POST": "POST",
        "PUT": "PUT",
        "DELETE": "DELETE",
        "PATCH": "PATCH",
        "HEAD": "HEAD"
      },
      "path_from": [
        "Path"
      ],
      "prefix": {
        "names": [
          "Path"
        ]
      },
      "unit_kind": "controller",
      "require": "path-or-prefix"
    }
  ]
}
